generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Category {
  id    Int    @id @default(autoincrement()) @db.UnsignedTinyInt
  title String @unique @db.VarChar(31)
  Post  Post[]
}

model Comment {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  post_id    Int       @db.UnsignedInt
  writer     Int       @db.UnsignedInt

  parent_id  Int?      @db.UnsignedInt   // ⭐ 답글용
  content    String    @db.Text

  is_deleted Boolean   @default(false)    // ⭐ Admin 삭제 표현용
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  Post       Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  User       User      @relation(fields: [writer], references: [id])

  Parent     Comment?  @relation("CommentReply", fields: [parent_id], references: [id])
  Replies    Comment[] @relation("CommentReply")

  @@index([post_id])
  @@index([writer])
  @@index([parent_id])
}

model Post {
  id         Int        @id @default(autoincrement()) @db.UnsignedInt
  category   Int        @db.UnsignedTinyInt
  title      String     @db.VarChar(255)
  writer     Int        @db.UnsignedInt
  contents   String?    @db.Text
  readcnt    Int        @default(0) @db.UnsignedInt
  created_at DateTime   @default(now()) @db.DateTime(0)
  updated_at DateTime @updatedAt @db.DateTime(0)
  Comment    Comment[]
  Category   Category   @relation(fields: [category], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "Post_ibfk_1")
  User       User       @relation(fields: [writer], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Post_ibfk_2")
  PostLike   PostLike[]

  @@index([category], map: "fk_Post_category")
  @@index([writer], map: "fk_Post_writer")
}

model PostLike {
  post_id    Int      @db.UnsignedInt
  user_id    Int      @db.UnsignedInt
  created_at DateTime @default(now()) @db.DateTime(0)
  Post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "PostLike_ibfk_1")
  User       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "PostLike_ibfk_2")

  @@id([post_id, user_id])
  @@index([user_id], map: "fk_PostLike_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model StopWord {
  id    Int    @id @default(autoincrement()) @db.UnsignedInt
  value String @unique(map: "uniq_StopWord_value") @db.VarChar(31)
}

model User {
  id       Int        @id @default(autoincrement()) @db.UnsignedInt
  name     String     @db.VarChar(31)
  email    String     @unique(map: "uniq_User_email") @db.VarChar(255)
  image    String?    @db.VarChar(255)
  passwd   String?    @db.VarChar(256)
  isadmin  Boolean    @default(false)
  outdt    DateTime?  @db.DateTime(0)
  Comment  Comment[]
  Post     Post[]
  PostLike PostLike[]

  @@map("User")
}
